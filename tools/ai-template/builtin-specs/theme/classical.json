{
  "version": 1,
  "kind": "theme",
  "key": "classical",
  "name": "古典",
  "intent": "现有古典主题抽取：宣纸米色、墨色、朱砂与赭金点缀",
  "mode": "light",
  "tokens": {
    "--bg": "#f3eee2",
    "--surface": "#fbf7ec",
    "--text": "#2d2822",
    "--text-sub": "#6a6155",
    "--text-mute": "#9b9183",
    "--border": "#ddd1bc",
    "--brand": "#8c2f21",
    "--brand-soft": "#f2e3da",
    "--shadow": "0 1px 0 rgba(120, 90, 60, .08), 0 6px 18px rgba(120, 90, 60, .08)",
    "--radius": "6px",
    "--radius-sm": "3px",
    "--radius-pill": "999px",
    "--font-sans": "\"Songti SC\", \"STSong\", \"Noto Serif SC\", \"SimSun\", Georgia, serif",
    "--font-display": "\"Songti SC\", \"STSong\", \"Noto Serif SC\", \"SimSun\", Georgia, serif",
    "--fs-hero": "clamp(29px, 4vw, 40px)",
    "--fs-title": "19px",
    "--fs-body": "15px",
    "--fs-sm": "13px",
    "--fs-xs": "12px",
    "--gap-card": "18px",
    "--pad-card": "18px",
    "--shadow-hover": "0 2px 2px rgba(120, 90, 60, .1), 0 12px 26px rgba(120, 90, 60, .12)",
    "--brand-2": "#a9854f",
    "--hero-wash": "radial-gradient(1000px 380px at 12% -12%, rgba(140, 47, 33, .1), rgba(140, 47, 33, 0) 70%)",
    "--header-bg": "rgba(243, 238, 226, .9)",
    "--plat-bilibili": "#fb7299",
    "--plat-wechat": "#07c160",
    "--plat-xhs": "#ff2442",
    "--plat-multi": "#5b6472"
  },
  "rationale": [
    "保留现有内置主题的主色、背景与字体特征",
    "29 个 token 与现有 CSS 一一对应",
    "抽取为 Spec 后可从内置主题克隆新版本"
  ],
  "limits": {
    "maxCssKb": 4,
    "maxRules": 40
  }
}
