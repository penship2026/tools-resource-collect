# 系统与编辑器垃圾文件
.DS_Store
Thumbs.db
*.swp

# Python 缓存
__pycache__/
*.pyc

# 本地数据备份与自动快照(仅保留在本地,不进仓库)
backups/

# 个人收藏导出文件(含浏览偏好,不进仓库)
个人收藏-*.json
personal-*.json

# 本机调度用的未公开主题清单
topics.local.yml
schedule.local.yml

# 本机定时任务的运行日志
logs/

# 本地工具数据(工作区记忆、浏览器测试产物等),不进仓库
.workbuddy/
.playwright-cli/

# 二期 AI 设计草稿与本地密钥(仅本机,不进仓库)
tools/ai-template/drafts/*
!tools/ai-template/drafts/.gitkeep
tools/ai-template/cache/
tools/ai-template/.env
tools/ai-template/*.local.json
