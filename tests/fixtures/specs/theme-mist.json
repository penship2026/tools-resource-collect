{
  "version": 1,
  "kind": "theme",
  "key": "mist",
  "name": "雾青",
  "intent": "低饱和青绿，适合长时间阅读的浅色主题",
  "mode": "light",
  "tokens": {
    "--bg": "#f6f8f4",
    "--surface": "#ffffff",
    "--text": "#1f2a24",
    "--text-sub": "#4d5d54",
    "--text-mute": "#728178",
    "--border": "#d8e2da",
    "--brand": "#2f6f4e",
    "--brand-soft": "#e6f1ea",
    "--shadow": "0 8px 24px rgba(31, 42, 36, .08)",
    "--radius": "14px",
    "--radius-sm": "10px",
    "--radius-pill": "999px",
    "--font-sans": "system-ui, -apple-system, sans-serif",
    "--font-display": "Georgia, serif",
    "--fs-hero": "40px",
    "--fs-title": "22px",
    "--fs-body": "15px",
    "--fs-sm": "13px",
    "--fs-xs": "12px",
    "--gap-card": "18px",
    "--pad-card": "20px",
    "--shadow-hover": "0 12px 30px rgba(31, 42, 36, .12)",
    "--brand-2": "#7aa98d",
    "--hero-wash": "linear-gradient(180deg, #ffffff, #f6f8f4)",
    "--header-bg": "rgba(255, 255, 255, .86)",
    "--plat-bilibili": "#fb7299",
    "--plat-wechat": "#2f6f4e",
    "--plat-xhs": "#ff2442",
    "--plat-multi": "#6b7280"
  },
  "rationale": [
    "青绿主色与深灰正文保持 4.5 以上对比",
    "背景与 surface 只差一级，卡片边界靠细边线",
    "沿用系统字体，避免外链字体拖慢首屏"
  ],
  "limits": { "maxCssKb": 4, "maxRules": 40 }
}
