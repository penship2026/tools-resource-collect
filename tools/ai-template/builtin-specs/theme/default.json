{
  "version": 1,
  "kind": "theme",
  "key": "default",
  "name": "浅色",
  "intent": "现有浅色主题抽取：蓝主色、白卡片、轻阴影，作为默认内置主题",
  "mode": "light",
  "tokens": {
    "--bg": "#f7f8fa",
    "--surface": "#ffffff",
    "--text": "#1a1d21",
    "--text-sub": "#6b7280",
    "--text-mute": "#9ca3af",
    "--border": "#e8eaee",
    "--brand": "#2d7ff9",
    "--brand-soft": "#eaf2ff",
    "--shadow": "0 1px 3px rgba(16, 24, 40, .04), 0 8px 24px rgba(16, 24, 40, .04)",
    "--radius": "14px",
    "--radius-sm": "9px",
    "--radius-pill": "999px",
    "--font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--font-display": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--fs-hero": "clamp(30px, 4.2vw, 42px)",
    "--fs-title": "19px",
    "--fs-body": "15px",
    "--fs-sm": "13px",
    "--fs-xs": "12px",
    "--gap-card": "18px",
    "--pad-card": "18px",
    "--shadow-hover": "0 14px 32px rgba(16, 24, 40, .12), 0 2px 6px rgba(16, 24, 40, .06)",
    "--brand-2": "#6aa8ff",
    "--hero-wash": "radial-gradient(1200px 380px at 12% -10%, rgba(45, 127, 249, .16), rgba(45, 127, 249, 0) 70%)",
    "--header-bg": "rgba(255, 255, 255, .86)",
    "--plat-bilibili": "#fb7299",
    "--plat-wechat": "#07c160",
    "--plat-xhs": "#ff2442",
    "--plat-multi": "#5b6472"
  },
  "rationale": [
    "保留现有内置主题的主色、背景与字体特征",
    "29 个 token 与现有 CSS 一一对应",
    "抽取为 Spec 后可从内置主题克隆新版本"
  ],
  "limits": {
    "maxCssKb": 4,
    "maxRules": 40
  }
}
