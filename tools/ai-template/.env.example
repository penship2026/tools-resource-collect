# 复制为 .env 后填写；.env 已在 .gitignore，Key 不入库
# OpenAI 兼容端点（结尾到 /chat/completions 前即可）

# 方案一：OpenRouter 免费模型（需注册获取 Key；免预充值）
# 注册后创建 Key，免费模型每日约 50 次额度
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=baidu/ernie-5.5-flash-preview:free
AI_TIMEOUT=120

# 备选免费模型（换成 AI_MODEL 即可，均需 :free 后缀）
# nvidia/nemotron-3-ultra-550b-a55b:free
# google/gemma-4-31b-it:free
# nvidia/nemotron-3.5-lightning:free

# 方案二：本机 Ollama，无需 Key（慢，适合离线验证流程）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama-local
# AI_MODEL=deepseek-r1:7b
# AI_TIMEOUT=300
