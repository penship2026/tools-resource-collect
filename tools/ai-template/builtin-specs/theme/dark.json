    "--brand-2": "#8fbcff",
    "--hero-wash": "radial-gradient(1200px 380px at 12% -10%, rgba(91, 157, 255, .22), rgba(91, 157, 255, 0) 70%)",
    "--header-bg": "rgba(15, 17, 21, .86)",
    "--plat-bilibili": "#fb7299",
    "--plat-wechat": "#07c160",
    "--plat-xhs": "#ff2442",
    "--plat-multi": "#7c8798"
