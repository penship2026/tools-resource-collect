{
  "version": 1,
  "kind": "theme",
  "key": "dark",
  "name": "深色",
  "intent": "现有深色主题抽取：深底浅字、蓝色强调，适合夜间阅读",
  "mode": "dark",
  "tokens": {
    "--bg": "#0f1115",
    "--surface": "#181b21",
    "--text": "#e8eaed",
    "--text-sub": "#9ca3af",
    "--text-mute": "#6b7280",
    "--border": "#2a2e37",
    "--brand": "#5b9dff",
    "--brand-soft": "#1b2e4a",
    "--shadow": "0 1px 3px rgba(0, 0, 0, .3), 0 8px 24px rgba(0, 0, 0, .25)",
    "--radius": "14px",
    "--radius-sm": "9px",
    "--radius-pill": "999px",
    "--font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--font-display": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--fs-hero": "clamp(30px, 4.2vw, 42px)",
    "--fs-title": "19px",
    "--fs-body": "15px",
    "--fs-sm": "13px",
